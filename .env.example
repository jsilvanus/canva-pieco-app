# Build-time environment variables for canva-pieco-app
# These variables are baked into the static bundle during `pnpm run build`

# Display name of the plugin inside Canva
VITE_APP_NAME="Keskuskirkko Slide Bridge"

# Default Pi Gateway base URL (must be HTTPS in the Canva environment). This is the church VPS
# address that reaches pigateway's Canva-only listener through the radio tunnel.
VITE_GATEWAY_URL="https://kehitys.riihimaenseurakunta.fi/canva"

# Leave empty: a key baked into the bundle is readable by everybody. Operators enter the key in Settings.
VITE_GATEWAY_API_KEY=""

# Base URL of the Sissi signage service, including any path prefix (https only), for example https://host/signage.
# The "Signage (Sissi)" target is enabled only when this (or the Settings field) is set.
VITE_SIGNAGE_URL=""

# Leave empty: only for testing outside Canva. Never bake a key into the bundle (build:js clears it).
VITE_SIGNAGE_PUSH_KEY=""

# Sign in with Tunnus through Canva's OAuth (1 to turn on). Needs an Auth provider in the Canva Developer
# Portal with the identifier below. While off, the app uses the Canva user token (or the key in Settings).
VITE_TUNNUS_SIGN_IN="1"
VITE_AUTH_PROVIDER="tunnus"
