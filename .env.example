# Build-time environment variables for canva-pieco-app
# These variables are baked into the static bundle during `pnpm run build`

# Display name of the plugin inside Canva
VITE_APP_NAME="Keskuskirkko Slide Bridge"

# Default Pi Gateway base URL (must be HTTPS in the Canva environment). This is the church VPS
# address that reaches pigateway's Canva-only listener through the radio tunnel.
VITE_GATEWAY_URL="https://kehitys.riihimaenseurakunta.fi/canva"

# Leave empty: a key baked into the bundle is readable by everybody. Operators enter the key in Settings.
VITE_GATEWAY_API_KEY=""
