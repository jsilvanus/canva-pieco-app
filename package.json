{
  "name": "canva-pieco-app",
  "version": "1.0.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "description": "Canva App plugin for church slide presentations and Pi Gateway control",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p . && eslint src && vite build",
    "test": "node --test test/*.test.mjs",
    "build:js": "VITE_GATEWAY_API_KEY= vite build -c vite.js-only.config.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-ui-kit": "^5.15.0",
    "@canva/design": "^2.14.0",
    "@canva/intents": "^2.8.0",
    "@canva/platform": "^2.2.3",
    "@canva/user": "^2.3.0",
    "@formatjs/intl": "3.1.8",
    "intl-messageformat": "10.7.18",
    "mobx": "^6.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "7.1.14"
  },
  "devDependencies": {
    "@canva/app-eslint-plugin": "^1.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "babel-plugin-formatjs": "^10.5.41",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "vite": "^6.2.0"
  },
  "pi": {
    "service": "canva-pieco-app",
    "displayName": "canva-pieco-app",
    "layer": "Seam",
    "kind": "library"
  }
}
